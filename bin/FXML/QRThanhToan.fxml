<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.layout.VBox?>

<?import javafx.scene.web.WebView?>
<VBox xmlns="http://javafx.com/javafx/21"
      xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="controllers.QRThanhToanController"
      alignment="CENTER"
      spacing="12"
      prefWidth="360"
      style="-fx-background-color: white; -fx-border-color: #3eaee6 ; -fx-border-radius: 15; -fx-background-radius: 15;">

    <padding>
        <Insets top="20" right="20" bottom="20" left="20"/>
    </padding>

    <Label text="THANH TOÁN QUA QR"
           style="-fx-font-size: 18; -fx-font-weight: bold; -fx-text-fill: #23466E;"/>

    <Label fx:id="lblMaHD"
           text="Mã hóa đơn: HD0001"
           style="-fx-font-size: 13;"/>

    <Label fx:id="lblSoTien"
           text="Số tiền: 0 VNĐ"
           style="-fx-font-size: 17; -fx-font-weight: bold; -fx-text-fill: #D9463E;"/>
    <WebView fx:id="webQR"
             prefWidth="280"
             prefHeight="280"
             minWidth="280"
             minHeight="280"
             maxWidth="280"
             maxHeight="280"/>

    <Label fx:id="lblTrangThai"
           text="Quét mã QR để thanh toán"
           wrapText="true"
           style="-fx-font-size: 11; -fx-text-fill: #555555;"/>

    <Button fx:id="btnXacNhan"
            text="Đã chuyển xong"
            maxWidth="Infinity"
            style="-fx-background-color: #259678; -fx-text-fill: white; -fx-font-weight: bold; -fx-padding: 10;"/>

    <Button fx:id="btnHuy"
            text="Hủy giao dịch"
            maxWidth="Infinity"
            style="-fx-background-color: #D9463E; -fx-text-fill: white; -fx-font-weight: bold; -fx-padding: 10;"/>


</VBox>