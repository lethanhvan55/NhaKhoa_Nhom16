<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Label?>
<?import javafx.scene.layout.ColumnConstraints?>
<?import javafx.scene.layout.GridPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<VBox alignment="TOP_CENTER" spacing="8"
      prefWidth="500"
      style="-fx-padding: 25; -fx-background-color: white; -fx-font-family: 'Arial';"
      xmlns="http://javafx.com/javafx/21"
      xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="controllers.HoaDonInController">

    <Label text="PHÒNG KHÁM NHA KHOA"
           style="-fx-font-size: 22; -fx-font-weight: bold; -fx-text-fill: #174A78;"/>

    <Label text="Địa chỉ: 134 Phường 15 TP.HCM"/>
    <Label text="Điện thoại: 0398899311"/>

    <Label text="HÓA ĐƠN THANH TOÁN"
           style="-fx-font-size: 18; -fx-font-weight: bold;"/>

    <Label fx:id="lblMaHD"
           text="HD0001"
           style="-fx-font-size: 14; -fx-font-weight: bold;"/>

    <Label text="------------------------------------------------------------"/>

    <GridPane hgap="10" vgap="8">
        <columnConstraints>
            <ColumnConstraints percentWidth="35"/>
            <ColumnConstraints percentWidth="65"/>
        </columnConstraints>

        <children>
            <Label text="Ngày lập:"/>
            <Label fx:id="lblNgayLap" GridPane.columnIndex="1"/>

            <Label text="Họ tên:" GridPane.rowIndex="2"/>
            <Label fx:id="lblTenBN" GridPane.columnIndex="1" GridPane.rowIndex="2"/>

            <Label text="Số điện thoại:" GridPane.rowIndex="3"/>
            <Label fx:id="lblSoDT" GridPane.columnIndex="1" GridPane.rowIndex="3"/>

            <Label text="Nhân viên:" GridPane.rowIndex="4"/>
            <Label fx:id="lblNhanVien" GridPane.columnIndex="1" GridPane.rowIndex="4"/>
        </children>
    </GridPane>

    <Label text="CHI TIẾT DỊCH VỤ"
           style="-fx-font-size: 15; -fx-font-weight: bold;"/>

    <HBox spacing="5" alignment="CENTER_LEFT">
        <Label text="Tên dịch vụ" prefWidth="230"
               style="-fx-font-weight: bold;"/>
        <Label text="SL" prefWidth="35"
               style="-fx-font-weight: bold;"/>
        <Label text="Đơn giá" prefWidth="100"
               style="-fx-font-weight: bold;"/>
        <Label text="Thành tiền"
               style="-fx-font-weight: bold;"/>
    </HBox>

    <Label text="------------------------------------------------------------"/>

    <VBox fx:id="vboxChiTiet" spacing="8"/>

    <Label text="------------------------------------------------------------"/>

    <GridPane hgap="10" vgap="8">
        <columnConstraints>
            <ColumnConstraints percentWidth="55"/>
            <ColumnConstraints percentWidth="45"/>
        </columnConstraints>

        <children>
            <Label text="Tổng tiền dịch vụ:"/>
            <Label fx:id="lblTongTien" GridPane.columnIndex="1"/>

            <Label text="Chiết khấu:" GridPane.rowIndex="1"/>
            <Label fx:id="lblGiamGia" GridPane.columnIndex="1" GridPane.rowIndex="1"/>

            <Label text="VAT:" GridPane.rowIndex="2"/>
            <Label fx:id="lblThue" GridPane.columnIndex="1" GridPane.rowIndex="2"/>

            <Label text="Tổng thanh toán:"
                   style="-fx-font-weight: bold;"
                   GridPane.rowIndex="3"/>

            <Label fx:id="lblTongTT"
                   style="-fx-font-size: 17; -fx-font-weight: bold; -fx-text-fill: #174A78;"
                   GridPane.columnIndex="1" GridPane.rowIndex="3"/>
        </children>
    </GridPane>

    <Label text="TRÂN TRỌNG CẢM ƠN QUÝ KHÁCH!"
           style="-fx-font-size: 14; -fx-font-weight: bold;"/>

    <Label text="Chúc quý khách luôn có nụ cười khỏe đẹp!"
           style="-fx-font-style: italic;"/>

</VBox>
